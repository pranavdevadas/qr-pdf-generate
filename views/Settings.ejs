<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/login.css" />
    <link rel="icon" href="/qr.png">
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <!-- Font Awesome -->
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap"
      rel="stylesheet"
    />
    <!-- MDB -->
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/8.1.0/mdb.min.css"
      rel="stylesheet"
    />
    <title>Settings</title>
  </head>
  <body>
    <section class="gradient-custom" style="width: 100%">
      <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
          <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card bg-dark text-white" style="border-radius: 1rem">
              <div class="card-body p-5 text-center">
                <div class="mb-md-5 mt-md-4 pb-5">
                  <h2 class="fw-bold mb-2 text-uppercase">Settings</h2>
                  <form action="/settings" method="POST">
                    <!-- Expiry Period -->
                    <label class="form-label">Select Expiry Period</label>
                    <div class="form-outline form-white mb-4 ms-5">
                      <div class="row text-start ms-1">
                        <div class="col-6 mb-2">
                          <div class="form-check">
                            <input
                              class="form-check-input"
                              type="radio"
                              name="expiryPeriod"
                              id="expiry1Week"
                              value="0"
                              checked
                            />
                            <label class="form-check-label" for="expiry1Week">
                              1 Week
                            </label>
                          </div>
                        </div>
                        <div class="col-6 mb-2">
                          <div class="form-check">
                            <input
                              class="form-check-input"
                              type="radio"
                              name="expiryPeriod"
                              id="expiry2Weeks"
                              value="7"
                            />
                            <label class="form-check-label" for="expiry2Weeks">
                              2 Weeks
                            </label>
                          </div>
                        </div>
                        <div class="col-6 mb-2">
                          <div class="form-check">
                            <input
                              class="form-check-input"
                              type="radio"
                              name="expiryPeriod"
                              id="expiry3Weeks"
                              value="14"
                            />
                            <label class="form-check-label" for="expiry3Weeks">
                              3 Weeks
                            </label>
                          </div>
                        </div>
                        <div class="col-6 mb-2">
                          <div class="form-check">
                            <input
                              class="form-check-input"
                              type="radio"
                              name="expiryPeriod"
                              id="expiry1Month"
                              value="21"
                            />
                            <label class="form-check-label" for="expiry1Month">
                              30 Days
                            </label>
                          </div>
                        </div>
                      </div>
                    </div>

                    <hr />

                    <div class="form-outline form-white mb-4">
                      <label for="voucherWidth" class="form-label">
                        Voucher Width
                        <span id="widthRangeValue">170</span>
                      </label>
                      <input
                        type="range"
                        class="form-range"
                        id="voucherWidth"
                        name="voucherWidth"
                        min="150"
                        max="170"
                        value="170"
                      />
                    </div>

                    <!-- Voucher Height -->
                    <div class="form-outline form-white mb-4">
                      <label for="voucherHeight" class="form-label">
                        Voucher Height
                        <span id="heightRangeValue">170</span>
                      </label>
                      <input
                        type="range"
                        class="form-range"
                        id="voucherHeight"
                        name="voucherHeight"
                        min="170"
                        max="270"
                        value="170"
                      />
                    </div>

                    <hr />

                    <!-- Title Font Size -->
                    <div class="form-outline form-white mb-4">
                      <label for="titleFontSize" class="form-label">
                        Title Font Size
                        <span id="titleFontSizeValue">24</span>
                      </label>
                      <input
                        type="range"
                        class="form-range"
                        min="20"
                        max="30"
                        id="titleFontSize"
                        name="titleFontSize"
                        value="24"
                      />
                    </div>

                    <!-- Normal Text Font Size -->
                    <div class="form-outline form-white mb-4">
                      <label for="textFontSize" class="form-label">
                        Normal Text Font Size
                        <span id="textFontSizeValue">12</span>
                      </label>
                      <input
                        type="range"
                        class="form-range"
                        min="10"
                        max="20"
                        id="textFontSize"
                        name="textFontSize"
                        value="12"
                      />
                    </div>

                    <% if (messages.alert) { %>
                    <div class="alert alert-danger" id="successAlert">
                      <%= messages.alert %>
                    </div>
                    <% } %>

                    <button
                      class="btn btn-outline-light btn-lg px-5"
                      type="button"
                      onclick="downloadPDF('<%= voucherId %>', '<%= voucherNumber %>', '<%= voucherGenDate %>', '<%= voucherExpDate %>', '<%=  voucherQr %>')"
                    >
                      Download Pdf
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script
      type="text/javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/8.1.0/mdb.umd.min.js"
    ></script>
    <script>
      setTimeout(() => {
        const alertElement = document.getElementById("successAlert");
        if (alertElement) {
          alertElement.style.display = "none";
        }
      }, 2000);
    </script>

    <script>
      document
        .getElementById("voucherHeight")
        .addEventListener("input", function () {
          const heightValue = this.value;
          document.getElementById("heightRangeValue").textContent = heightValue;

          const doc = new jsPDF();
          doc.setDrawColor(0, 0, 0);
          doc.setLineWidth(1);
          doc.rect(20, 10, 170, parseInt(heightValue));
        });

      document
        .getElementById("voucherWidth")
        .addEventListener("input", function () {
          const widthtValue = this.value;
          document.getElementById("widthRangeValue").textContent = widthtValue;

          const doc = new jsPDF();
          doc.setDrawColor(0, 0, 0);
          doc.setLineWidth(1);
          doc.rect(20, 10, parseInt(widthtValue), parseInt(heightValue));
        });

      document
        .getElementById("titleFontSize")
        .addEventListener("input", function () {
          const titleFontSizeValue = this.value;
          document.getElementById("titleFontSizeValue").textContent =
            titleFontSizeValue;
        });

      document
        .getElementById("textFontSize")
        .addEventListener("input", function () {
          const textFontSizeValue = this.value;
          document.getElementById("textFontSizeValue").textContent =
            textFontSizeValue;
        });

      function downloadPDF(
        voucherId,
        voucherNumber,
        generatedDate,
        expiryDate,
        qrCodeUrl
      ) {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        const titleFontSize = parseInt(
          document.getElementById("titleFontSize").value
        );
        const textFontSize = parseInt(
          document.getElementById("textFontSize").value
        );

        const voucherHeight = parseInt(
          document.getElementById("voucherHeight").value
        );

        const voucherWidth = parseInt(
          document.getElementById("voucherWidth").value
        );

        const expiryPeriodValue = parseInt(
          document.querySelector("input[name='expiryPeriod']:checked").value
        );

        let calculatedExpiryDate = new Date(expiryDate);
        calculatedExpiryDate.setDate(
          calculatedExpiryDate.getDate() + expiryPeriodValue
        );

        updateVoucherExpiry(voucherId, calculatedExpiryDate);

        doc.setDrawColor(0, 0, 0);
        doc.setLineWidth(1);
        doc.rect(20, 10, voucherWidth, voucherHeight);

        // Title: Voucher
        doc.setFont("helvetica", "bold");
        doc.setTextColor(0, 0, 255);
        doc.setFontSize(titleFontSize);
        doc.text("Voucher", 105, 20, null, null, "center");

        const formattedGeneratedDate = formatDate(generatedDate);
        doc.setTextColor(0, 0, 0);
        doc.setFontSize(textFontSize);
        doc.text(
          `Generated Date: ${formattedGeneratedDate}`,
          105,
          35,
          null,
          null,
          "center"
        );

        // Expiry Date
        const formattedExpiryDate = formatDate(calculatedExpiryDate);
        doc.setTextColor(255, 0, 0); // Red
        doc.setFontSize(textFontSize);
        doc.text(
          `Expiry Date: ${formattedExpiryDate}`,
          105,
          45,
          null,
          null,
          "center"
        );

        doc.addImage(`${qrCodeUrl}`, "JPEG", 55, 55, 100, 100);

        // Voucher Number
        doc.setTextColor(0, 0, 0);
        doc.setFontSize(textFontSize);
        doc.text(
          `Voucher Number: ${voucherNumber}`,
          105,
          160,
          null,
          null,
          "center"
        );

        // Save the PDF
        doc.save(`voucher_${voucherNumber}.pdf`);
      }

      function updateVoucherExpiry(voucherId, expiryDate) {
        fetch("/update-expiry", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            voucherId,
            expiryDate: expiryDate.toISOString(), // Send date in ISO format
          }),
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error("Failed to update expiry date in the database.");
            }
            return response.json();
          })
          .then((data) => {
            console.log("Expiry date updated successfully:", data);
          })
          .catch((error) => {
            console.error("Error updating expiry date:", error);
          });
      }

      function formatDate(dateString) {
        const date = new Date(dateString);
        const day = String(date.getDate()).padStart(2, "0");
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const year = date.getFullYear();
        return `${day}/${month}/${year}`;
      }
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  </body>
</html>
